{
  "name": "pathian-ram-tithe-app",
  "version": "1.0.0",
  "description": "Secure, high-performance Tithe Collection Web Application for Pathian Ram",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "deploy:cloudflare": "vite build && npx wrangler pages deploy dist --project-name thawhlawmptr",
    "deploy:live": "vite build && npx wrangler pages deploy dist --project-name thawhlawmptr",
    "deploy:test": "vite build && npx wrangler pages deploy dist --project-name thawhlawmptr-test",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "hono": "^4.13.3",
    "html2canvas-pro": "^2.4.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.475.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.7",
    "vite": "^6.1.0",
    "wrangler": "^4.125.0"
  }
}
